# LabelGuard — Environment Configuration Template
# Copy this file to .env.local for local development

# ===================================================
# 1. OCR MICROSERVICE CONFIGURATION
# ===================================================
# URL of the local Python FastAPI OCR service
OCR_SERVICE_URL=http://127.0.0.1:8000

# ===================================================
# 2. GEMINI SEMANTIC EXTRACTION ENGINE
# ===================================================
# Google Gemini API key for post-OCR semantic declaration extraction.
# If unset, LabelGuard seamlessly falls back to its deterministic
# bilingual rule-based pattern extractor with full audit logging.
GEMINI_API_KEY=

# Model selection for semantic extraction (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ===================================================
# 3. APPLICATION RUNTIME
# ===================================================
NEXT_PUBLIC_APP_NAME="LabelGuard — Compliance & Inspection Platform"
NEXT_PUBLIC_APP_VERSION="1.0.0"
